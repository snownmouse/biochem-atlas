  "annotations": [
    { "x": 40, "y": 78, "text": "Lehninger 8e Ch.18 碳骨架去路分组；20 种按 14 / 4 / 2 成簇，不平铺", "size": 9.2 },
    { "x": 1512, "y": 118, "text": "分组依据 · SOURCE", "size": 10.5, "weight": 700 },
    { "x": 1512, "y": 138, "text": "Lehninger Principles of Biochemistry, 8e,", "size": 9 },
    { "x": 1512, "y": 154, "text": "Ch.18 碳骨架去路分组表", "size": 9 },
    { "x": 1512, "y": 176, "text": "生糖 14 + 生糖兼生酮 4 + 生酮 2 = 20", "size": 9 },
    { "x": 1512, "y": 198, "text": "生酮仅 Leu、Lys（8e 口径）", "size": 9 },
    { "x": 1512, "y": 220, "text": "Thr 分歧：8e 列生糖；部分教材按", "size": 9 },
    { "x": 1512, "y": 236, "text": "乙酰-CoA 生成列生糖兼生酮。", "size": 9 },
    { "x": 1512, "y": 252, "text": "本页按 8e 归生糖，分歧并列，不裁定。", "size": 9 },

    { "x": 40, "y": 372, "text": "转氨把氨基集中到 Glu；GLDH / GLS 把氨基释放为 NH₄⁺；PLP 与 NAD(P)⁺ 为辅因子", "size": 9.2 },
    { "x": 40, "y": 404, "text": "调控 · REGULATION", "size": 10.5, "weight": 700 },
    { "x": 40, "y": 424, "text": "GLDH：ADP / GDP + Leu 激活；ATP / GTP 抑制", "size": 9 },
    { "x": 40, "y": 442, "text": "BCKDH：BCKDK 磷酸化失活；PDP1 去磷酸激活", "size": 9 },
    { "x": 40, "y": 460, "text": "胰岛素促进 BCKDH 去磷酸（进食后）", "size": 9 },
    { "x": 1640, "y": 556, "text": "血氨处置见尿素循环 PLATE 09", "size": 9.2, "anchor": "middle" },
    { "x": 1640, "y": 576, "text": "3D 面板 pending：已核验 PDB 见右栏与 SF-11", "size": 8.8, "anchor": "middle" },
    { "x": 1640, "y": 594, "text": "本页不渲染酶 3D，只做 2D", "size": 8.8, "anchor": "middle" },

    { "x": 40, "y": 668, "text": "去路 id 均指向真实步骤；乙酰乙酸 + 乙酰-CoA 的生酮通路未建，置 unbuilt，不编造接口", "size": 9.2 },
    { "x": 160, "y": 828, "text": "来自 Ala · Cys · Gly · Ser · Thr · Trp", "size": 8.4, "anchor": "middle" },
    { "x": 430, "y": 828, "text": "来自 Leu · Lys · Ile · Phe · Tyr · Trp", "size": 8.4, "anchor": "middle" },
    { "x": 700, "y": 828, "text": "来自 Leu · Lys · Phe · Tyr · Trp", "size": 8.4, "anchor": "middle" },
    { "x": 970, "y": 828, "text": "来自 Glu · Gln · Arg · Pro · His", "size": 8.4, "anchor": "middle" },
    { "x": 1240, "y": 828, "text": "来自 Ile · Met · Val · Thr", "size": 8.4, "anchor": "middle" },
    { "x": 1510, "y": 828, "text": "来自 Asp · Phe · Tyr", "size": 8.4, "anchor": "middle" },
    { "x": 1780, "y": 828, "text": "来自 Asp", "size": 8.4, "anchor": "middle" },

    { "x": 54, "y": 946, "text": "ALT / AST 活性高；GLDH 释放的 NH₄⁺ 进入尿素循环", "size": 9 },
    { "x": 54, "y": 964, "text": "PAH、CBS 主要在此表达；丙氨酸–葡萄糖循环输出端", "size": 9 },
    { "x": 54, "y": 982, "text": "血氨处置：PLATE 09（不在本页重复画）", "size": 8.8 },

    { "x": 714, "y": 946, "text": "BCAT2 高表达；支链氨基酸转氨后经 BCKDH 氧化", "size": 9 },
    { "x": 714, "y": 964, "text": "肌缺完整尿素循环，氮以 Ala / Gln 送回肝", "size": 9 },
    { "x": 714, "y": 982, "text": "BCAA 是运动时肌内主要供能氨基酸", "size": 8.8 },

    { "x": 1334, "y": 946, "text": "GLS1 高表达，以谷氨酰胺生成 NH₄⁺ 排酸", "size": 9 },
    { "x": 1334, "y": 964, "text": "GLDH 可释放第二个氨，参与酸碱平衡", "size": 9 },
    { "x": 1334, "y": 982, "text": "CBS 也在此表达，参与 Hcy 清除", "size": 8.8 },

    { "x": 52, "y": 1176, "text": "Phe → Tyr 受阻；Phe 蓄积并经转氨生成苯丙酮酸", "size": 9 },
    { "x": 52, "y": 1194, "text": "BH₄ 合成 / 再生缺陷需另行鉴别（本页不画蝶呤通路）", "size": 9 },
    { "x": 712, "y": 1176, "text": "支链 α-酮酸（KIC 等）蓄积；BCKDH 缺陷是经典型", "size": 9 },
    { "x": 712, "y": 1194, "text": "BCAT2 是入口、BCKDH 是脱羧闸门，二者并列不混为一病", "size": 9 },
    { "x": 1332, "y": 1176, "text": "Hcy → 胱硫醚受阻，同型半胱氨酸蓄积", "size": 9 },
    { "x": 1332, "y": 1194, "text": "MTHFR / 钴胺素缺陷也可致升高，本页只画 CBS", "size": 9 }
  ]
}

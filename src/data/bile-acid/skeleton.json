  "transportSteps": [
    {
      "id": "bile-t1",
      "name": "BSEP 把结合胆汁酸分泌进胆汁",
      "from": "肝细胞（毛细胆管侧）",
      "via": "BSEP（ABCB11）逆浓度梯度转运",
      "to": "胆汁（胆管）",
      "note": "结合型胆汁酸是 BSEP 的主要底物；这一步是胆汁酸池离开肝细胞的出口，也是胆汁生成的限速环节。运输段不计入步数。"
    },
    {
      "id": "bile-t2",
      "name": "胆囊收缩把胆汁排入肠腔",
      "from": "胆囊 / 胆管",
      "via": "进食后胆囊收缩、Oddi 括约肌舒张",
      "to": "十二指肠 → 肠腔",
      "note": "无转运蛋白参与，属腔道内的整体流动。运输段不计入步数。"
    },
    {
      "id": "bile-t3",
      "name": "回肠末端重吸收并经门静脉回血",
      "from": "肠腔（回肠末端）",
      "via": "ASBT（SLC10A2）顶端摄取 → OSTα/OSTβ（SLC51A/B）基底侧输出",
      "to": "门静脉血",
      "note": "结合胆汁酸在回肠末端被主动重吸收，是肠肝循环的回收端；ASBT 为钠依赖性同向转运体。运输段不计入步数。"
    },
    {
      "id": "bile-t4",
      "name": "NTCP 把门静脉胆汁酸摄取回肝",
      "from": "门静脉血（肝窦侧）",
      "via": "NTCP（SLC10A1）钠依赖性摄取",
      "to": "肝细胞（回到胆汁酸池）",
      "note": "肝的首过摄取效率高，使门静脉血胆汁酸浓度维持在低水平。运输段不计入步数。"
    }
  ]

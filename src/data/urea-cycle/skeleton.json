  "transportSteps": [
    {
      "id": "urea-ornt1",
      "name": "瓜氨酸 / 鸟氨酸反向转运（ORNT1 / SLC25A15）",
      "from": "citrulline-mit",
      "via": "ornt1",
      "to": "citrulline-cyt",
      "note": "内膜反向转运：瓜氨酸出、鸟氨酸进，由同一个 ORNT1/SLC25A15 机器完成。它不是酶促步骤，不计入五步，也不消耗 ATP。"
    },
    {
      "id": "urea-asp-entry",
      "name": "天冬氨酸进入胞质",
      "from": "asp-entry",
      "via": "asp-entry",
      "to": "asp",
      "note": "天冬氨酸由 TCA 回流（延胡索酸 → 苹果酸 → 草酰乙酸）+ AST 转氨再生，经天冬氨酸穿梭进入胞质。本图只画供给箭头，不把它算作循环步。"
    }
  ],
  "spatialNote": "线粒体基质（60–250）放 CPS1 与 OTC 两步；内膜转运带（250–340）放 ORNT1/SLC25A15 与天冬氨酸进入；胞质（340–780）放 ASS、ASL、ARG1 三步。瓜氨酸出、鸟氨酸进，两条竖线显式穿越泳道边界；延胡索酸的 TCA 回流带在底部单独画出，不新增 TCA 中间节点。"
}
